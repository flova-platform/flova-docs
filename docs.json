{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Flova",
  "description": "مستندات فارسی پلتفرم فلووا برای ساخت، اتصال و ادارهٔ محصولات متصل.",
  "colors": {
    "primary": "#BFFF32",
    "light": "#D9FF83",
    "dark": "#6B8500"
  },
  "logo": {
    "light": "/assets/logo-light.svg",
    "dark": "/assets/logo-dark.svg",
    "href": "https://flova.ir"
  },
  "favicon": "/assets/favicon.svg",
  "appearance": {
    "default": "system",
    "strict": false
  },
  "fonts": {
    "family": "Dana",
    "source": "/assets/fonts/Dana-Regular.woff2",
    "format": "woff2",
    "heading": {
      "family": "Dana",
      "source": "/assets/fonts/Dana-DemiBold.woff2",
      "format": "woff2"
    }
  },
  "icons": {
    "library": "lucide"
  },
  "styling": {
    "eyebrows": "breadcrumbs",
    "codeblocks": "system"
  },
  "api": {
    "openapi": [
      {
        "source": "openapi/organization.yaml",
        "directory": "reference/organization-api"
      },
      {
        "source": "openapi/user.yaml",
        "directory": "reference/user-api"
      }
    ]
  },
  "navigation": {
    "groups": [
          {
            "group": "شروع کار",
            "icon": "rocket",
            "pages": ["index", "start/quickstart", "start/mental-model"]
          },
          {
            "group": "مفاهیم پلتفرم",
            "icon": "layers-3",
            "pages": [
              "concepts/overview",
              "concepts/product-device",
              "concepts/datastreams",
              "concepts/lifecycle",
              "reference/glossary"
            ]
          },
          {
            "group": "کنسول",
            "icon": "layout-dashboard",
            "pages": [
              "console/overview",
              "console/templates",
              "console/devices",
              "console/automation",
              "console/ota"
            ]
          },
          {
            "group": "استودیو",
            "icon": "panels-top-left",
            "pages": ["studio/overview", "studio/dashboards", "studio/bindings"]
          },
          {
            "group": "FlovaAI",
            "icon": "sparkles",
            "pages": ["flova-ai/overview", "flova-ai/workflow", "flova-ai/examples"]
          },
          {
            "group": "FlovaQL",
            "icon": "braces",
            "pages": ["flovaql/overview", "flovaql/queries", "flovaql/limits"]
          },
          {
            "group": "اتصال برنامه‌ها",
            "icon": "square-terminal",
            "pages": [
              "integrations/overview",
              "integrations/authentication",
              "integrations/errors",
              "integrations/organization-api",
              "integrations/user-api",
              "integrations/realtime"
            ]
          },
          {
            "group": "SDK و فریم‌ور",
            "icon": "cpu",
            "pages": [
              "sdk/overview",
              "sdk/install",
              "sdk/quickstart",
              "sdk/datastreams",
              "sdk/provisioning",
              "sdk/offline",
              "sdk/custom-boards",
              "sdk/security",
              "sdk/troubleshooting"
            ]
          },
          {
            "group": "راهنماهای عملی",
            "icon": "book-open-check",
            "pages": ["recipes/sensor-and-relay", "recipes/first-query", "recipes/first-dashboard"]
          },
          {
            "group": "پشتیبانی",
            "icon": "circle-help",
            "pages": ["reference/faq"]
          }
        ]
  }
}
