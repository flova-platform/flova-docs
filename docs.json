{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Flova",
  "description": "مستندات فارسی پلتفرم فلووا برای ساخت، اتصال و ادارهٔ محصولات متصل.",
  "colors": {
    "primary": "#BFFF32",
    "light": "#D9FF83",
    "dark": "#6B8500"
  },
  "logo": {
    "light": "/assets/logo-light.png",
    "dark": "/assets/logo-dark.png",
    "href": "https://flova.ir"
  },
  "favicon": "/assets/favicon.png",
  "appearance": {
    "default": "system",
    "strict": false
  },
  "icons": {
    "library": "lucide"
  },
  "styling": {
    "eyebrows": "breadcrumbs",
    "codeblocks": "system"
  },
  "api": {
    "openapi": [
      {
        "source": "openapi/organization.yaml",
        "directory": "reference/organization-api"
      },
      {
        "source": "openapi/user.yaml",
        "directory": "reference/user-api"
      }
    ]
  },
